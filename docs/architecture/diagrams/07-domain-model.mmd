%% PromptGuard — Fachliches Domain-Modell (Klassendiagramm)
%% Quelle: docs/requirements/PRD.md §7.1, §7.2; docs/api/openapi.yaml (components/schemas)
%% Jede fachliche Entität trägt organisation_id — Mandantentrennung auf Datenebene (SEC-002).

classDiagram
    direction LR

    class Organisation {
        +UUID id
        +String name
        +Severity scanThreshold
        +float duplicateThreshold
        +boolean duplicateDetectionEnabled
        +DateTime createdAt
    }

    class User {
        +UUID id
        +String email
        +String passwordHash
        +String displayName
        +Role role
        +UserStatus status
        +DateTime createdAt
    }

    class Membership {
        +UUID organisationId
        +UUID userId
        +Role role
        +UserStatus status
        +DateTime createdAt
    }

    class Invitation {
        +UUID id
        +UUID organisationId
        +String email
        +Role role
        +String tokenHash
        +InvitationStatus status
        +DateTime expiresAt
    }

    class Prompt {
        +UUID id
        +UUID organisationId
        +String title
        +String description
        +UUID categoryId
        +ScanStatus status
        +UUID currentVersionId
        +UUID createdBy
        +DateTime createdAt
        +DateTime updatedAt
    }

    class PromptVersion {
        +UUID id
        +UUID promptId
        +UUID organisationId
        +int versionNo
        +String content
        +String contentHash
        +ScanStatus status
        +UUID createdBy
        +DateTime createdAt
        +DateTime scannedAt
    }

    class Category {
        +UUID id
        +UUID organisationId
        +String name
        +boolean isDefault
        +boolean isActive
    }

    class Tag {
        +UUID id
        +UUID organisationId
        +String name
        +String normalisedName
    }

    class ScanRun {
        +UUID id
        +UUID promptVersionId
        +UUID organisationId
        +ScanRunStatus status
        +int attemptCount
        +DateTime startedAt
        +DateTime finishedAt
        +String lastError
    }

    class ScanFinding {
        +UUID id
        +UUID scanId
        +FindingCategory category
        +Severity severity
        +String redactedExcerpt
        +int startOffset
        +int endOffset
        +int line
        +String explanation
        +String detector
    }

    class Waiver {
        +UUID id
        +UUID promptVersionId
        +String reason
        +UUID waivedBy
        +DateTime waivedAt
    }

    class AuditEvent {
        +UUID id
        +UUID organisationId
        +UUID actorId
        +String action
        +String entityType
        +UUID entityId
        +DateTime at
        +Object metadata
    }

    class NotificationDelivery {
        +UUID id
        +UUID organisationId
        +UUID promptId
        +UUID promptVersionId
        +String recipient
        +NotificationStatus status
        +int attempts
        +String lastError
        +DateTime sentAt
    }

    class StatusTransition {
        +UUID id
        +UUID promptId
        +UUID promptVersionId
        +ScanStatus fromStatus
        +ScanStatus toStatus
        +DateTime at
        +String cause
    }

    class ScanJob {
        +UUID id
        +UUID organisationId
        +UUID promptVersionId
        +String status
        +int attemptCount
        +DateTime availableAt
        +DateTime lockedAt
        +String lockedBy
    }

    Organisation "1" -- "n" Membership : Mitglieder
    User "1" -- "1" Membership : gehört genau einer Organisation
    Organisation "1" -- "n" Invitation : Einladungen
    Organisation "1" -- "n" Prompt : Prompts
    Organisation "1" -- "n" Category : Kategorien (Seed-Liste)
    Organisation "1" -- "n" Tag : Tags
    Organisation "1" -- "n" AuditEvent : Audit
    Organisation "1" -- "n" NotificationDelivery : Zustellversuche
    Prompt "1" -- "n" PromptVersion : Versionen (unveränderlich)
    Prompt "n" -- "n" Tag : Tags
    Prompt "1" -- "1" Category : Kategorie
    PromptVersion "1" -- "1" ScanRun : Prüflauf
    ScanRun "1" -- "n" ScanFinding : Fundstellen
    PromptVersion "1" -- "0..1" Waiver : Ausnahme
    PromptVersion "1" -- "n" StatusTransition : Statusübergänge
    PromptVersion "1" -- "n" ScanJob : Prüfaufträge
    NotificationDelivery "n" --> "1" Prompt : Alarm zu
    AuditEvent "n" --> "1" User : Actor (anonymisierbar)

    note for PromptVersion "Invariante I-1: Die Freigabe ist an den content_hash gebunden. Jede inhaltliche Änderung erzeugt eine neue Version PENDING."

    note for ScanJob "Persistente Warteschlange (CON-009). organisation_id gehört in den Job-Kontext; ein Job ohne auflösbaren Tenant-Kontext wird verworfen und protokolliert (SEC-003)."

    note for AuditEvent "Ohne Inhalt. Nur Actor, Zeitpunkt, Aktion und technische Metadaten (SEC-010, FR-062)."
