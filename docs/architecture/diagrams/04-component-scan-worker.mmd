%% PromptGuard — C4 Level 3: Komponenten des Scan-Worker
%% Quelle: docs/requirements/PRD.md FR-030..FR-038, FR-042, FR-070; ADR-005, ADR-007

C4Component
  title "PromptGuard — Komponenten des Scan-Worker (C4 Level 3)"

  Container(api, "API-Service", "Spring Boot 3", "Erzeugt Scan-Jobs und liest den Status.")

  Container_Boundary(worker, "Scan-Worker — Spring Boot 3 / Java 21") {
    Component(poller, "Job-Poller", "Spring Scheduler + SELECT FOR UPDATE SKIP LOCKED", "Holt Jobs in Erstellungsreihenfolge, setzt Lock, verhindert Doppelverarbeitung. Überlebt Neustarts ohne Verlust (CON-009, AC-016-3).")
    Component(orchestrator, "Prüf-Orchestrator", "Spring Service", "Führt die Stufen (a) Vorprüfung, (b) Duplikatvergleich, (c) LLM-Klassifikation, (d) Aggregation in fester Reihenfolge aus (FR-031).")
    Component(precheck, "Lokale Vorprüfung", "Regelwerk + Entropieprüfung", "Deterministische Erkennung von Secrets und PII. Pflicht, läuft vor dem externen Aufruf (FR-031, F1).")
    Component(dedupe, "Duplikatvergleich", "Langchain4j Embeddings + normalisierter Textvergleich", "Ähnlichkeit >= 0,90 (organisationsweit konfigurierbar), ausschließlich innerhalb der eigenen Organisation, nie blockierend (FR-032, F8).")
    Component(classifier, "LLM-Klassifikation", "Langchain4j ChatModel", "Prompt-Injection und Jailbreak. Prüfling wird ausschließlich als Datenblock übergeben, Systemanweisung dominiert (SEC-007).")
    Component(verifier, "Provider-Verifikation", "Konfigurations-Gate", "Prüft AVV, EU-Region, Trainingsverbot, Löschgarantie. Bei Verstoß bricht der Scan ab, ohne dass Inhalt das System verlässt (FR-038, DP-005).")
    Component(aggregator, "Aggregation / Urteil", "Spring Service", "Bildet das Gesamturteil aus den Fundstellen: mind. ein Fund >= Schwelle => FLAGGED, sonst APPROVED (FR-036).")
    Component(state, "Status-Manager", "Spring Service + Transaktionen", "Setzt Version und Prompt-Status, schreibt Statusübergänge in die Historie und in die Outbox (FR-041).")
    Component(transfer, "Transfer-Audit", "Spring Service", "Protokolliert jede Übermittlung als Metadatenereignis ohne Inhalt: Zeitpunkt, Provider, Modell, Zeichenlänge, Ergebnis-ID, Korrelation-ID (FR-074, Art. 30 DSGVO).")
    Component(alerter, "Alarm-Auslöser", "Spring Service", "Bei FLAGGED: erzeugt Zustelljobs an die Security-Admins, sonst an die ORG_ADMINs (FR-050, FR-053).")
    Component(watchdog, "Watchdog", "Spring Scheduler", "Hängende SCANNING-Läufe nach > 5 min auf FAILED setzen und erneut auslösbar machen (FR-042).")
  }

  ContainerDb(db, "PostgreSQL 16", "PostgreSQL mit RLS", "Warteschlangen, Versionen, Fundstellen, Status, Outbox.")
  System_Ext(llm, "KI-Dienst (EU)", "Gemini 2.0 Flash / OpenAI, europe-west3, kein Training, keine dauerhafte Speicherung.")

  Rel(api, db, "legt Scan-Job ab", "SQL")
  Rel(poller, db, "holt und sperrt Job", "SQL")
  Rel(poller, orchestrator, "übergibt Job mit organisation_id", "Java")
  Rel(orchestrator, precheck, "Stufe (a)", "Java")
  Rel(orchestrator, dedupe, "Stufe (b)", "Java")
  Rel(orchestrator, verifier, "prüft Auflagen vor Stufe (c)", "Java")
  Rel(verifier, llm, "prüft Provider-Konfiguration", "HTTPS")
  Rel(orchestrator, classifier, "Stufe (c)", "Java")
  Rel(classifier, llm, "übermittelt Originalinhalt unverändert (F1)", "HTTPS, Langchain4j")
  Rel(orchestrator, aggregator, "Stufe (d)", "Java")
  Rel(aggregator, state, "setzt Urteil und Status", "Java")
  Rel(orchestrator, transfer, "protokolliert Übermittlung (Metadaten)", "Java")
  Rel(state, db, "schreibt Status, Historie, Outbox", "SQL")
  Rel(aggregator, alerter, "bei FLAGGED", "Java")
  Rel(alerter, db, "erzeugt Zustelljobs", "SQL")
  Rel(watchdog, db, "markiert hängende Läufe", "SQL")

  UpdateRelStyle(classifier, llm, $lineColor="#b3261e", $textColor="#b3261e")
  UpdateRelStyle(verifier, llm, $lineColor="#b3261e", $textColor="#b3261e")
