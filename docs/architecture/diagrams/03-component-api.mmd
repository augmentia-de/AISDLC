%% PromptGuard — C4 Level 3: Komponenten des API-Service
%% Quelle: docs/api/openapi.yaml; ADR-002 (Mandantenmodell), ADR-009 (Fehlermodell)

C4Component
  title "PromptGuard — Komponenten des API-Service (C4 Level 3)"

  Container(web, "Web-Frontend", "React 19, Next.js 15, TypeScript strict", "Client der REST-API und des SSE-Kanals.")

  Container_Boundary(api, "API-Service — Spring Boot 3 / Java 21") {
    Component(security, "Security-Konfiguration", "Spring Security, JJWT", "JWT-Verifikation, Claims (sub, organisation_id, role, exp), Security-Header, CORS, Rate-Limiting. Refresh-Token nur als HttpOnly-Cookie (SEC-001).")
    Component(tenant, "Mandanten-Kontext", "Spring Security HandlerInterceptor / RLS-Session", "Setzt organisation_id je Request und Job, erzwingt den Tenant-Filter, verwirft Jobs ohne auflösbaren Tenant-Kontext (SEC-003).")
    Component(authc, "Auth-Controller", "Spring MVC", "registerUser, loginUser, refreshTokens, logout. Sperre nach 10 Fehlversuchen/Min/IP.")
    Component(account, "Account-Controller", "Spring MVC", "getCurrentUser, updateOwnProfile, changeOwnPassword, exportOwnData, eraseOwnAccount, eraseUserAccount, exportUserData.")
    Component(orgctl, "Organisation-Controller", "Spring MVC", "Organisationseinstellungen, Mitglieder, Rollen, Einladungen, Alarmempfänger.")
    Component(promptctl, "Prompt-Controller", "Spring MVC", "createPrompt, listPrompts, getPrompt, updatePrompt, deletePrompt, Versionen, Diff, Historie, Status, Status-Stream.")
    Component(taxonomy, "Taxonomie-Controller", "Spring MVC", "Kategorien (CRUD, Deaktivierung bei Referenz) und Tags.")
    Component(scanctl, "Scan-Controller", "Spring MVC", "getScanResult, rescanPromptVersion, createWaiver, Provider-Verifikation.")
    Component(auditctl, "Audit-/Notification-/Privacy-Controller", "Spring MVC", "Audit-Ereignisse, Zustellversuche inkl. Totmannschaltung, Datenschutzhinweis DE/EN.")
    Component(opctl, "Operations-Controller", "Spring MVC", "getHealth, getMetrics — aggregiert, ohne Fachdaten.")
    Component(service, "Service-Schicht", "Spring Boot Service, Transaktionen", "Fachregeln: Versionierung (I-1), Freigabe-Gate (I-3), Schwellen, Tag-Normalisierung, Kapazitätsgrenzen.")
    Component(queue, "Warteschlange (Job-Erzeugung)", "Spring Data JPA", "Legt Scan- und Zustelljobs in der persistenten Warteschlange ab (CON-009). Kein In-Memory.")
    Component(sse, "SSE-Endpunkt", "Spring MVC SseEmitter", "Snapshot + Folgeereignisse aus der Outbox, monoton steigende Sequenz (ADR-005).")
    Component(err, "Fehlerabbildung", "@RestControllerAdvice", "Einheitliches Problem-Details-Format mit correlationId und Feldfehlern (ADR-009).")
  }

  ContainerDb(db, "PostgreSQL 16", "PostgreSQL mit RLS", "Fachdaten, Audit, Warteschlangen, Outbox.")

  Rel(web, security, "Ruft auf", "HTTPS")
  Rel(security, tenant, "setzt Kontext", "Java")
  Rel(security, authc, "delegiert", "Java")
  Rel(security, account, "delegiert", "Java")
  Rel(security, orgctl, "delegiert", "Java")
  Rel(security, promptctl, "delegiert", "Java")
  Rel(security, taxonomy, "delegiert", "Java")
  Rel(security, scanctl, "delegiert", "Java")
  Rel(security, auditctl, "delegiert", "Java")
  Rel(security, opctl, "delegiert", "Java")
  Rel(promptctl, sse, "liefert Status-Events", "Java")
  Rel(authc, service, "nutzt", "Java")
  Rel(account, service, "nutzt", "Java")
  Rel(orgctl, service, "nutzt", "Java")
  Rel(promptctl, service, "nutzt", "Java")
  Rel(taxonomy, service, "nutzt", "Java")
  Rel(scanctl, service, "nutzt", "Java")
  Rel(auditctl, service, "nutzt", "Java")
  Rel(opctl, service, "nutzt", "Java")
  Rel(service, db, "Liest/schreibt mit organisation_id-Filter", "SQL")
  Rel(service, queue, "erzeugt Jobs", "Java")
  Rel(queue, db, "INSERT in Warteschlange", "SQL")
  Rel(sse, db, "liest Outbox", "SQL")
  Rel(web, sse, "SSE-Kanal (Snapshot + Events)", "text/event-stream")
  Rel(err, web, "Problem-Details-Antwort", "JSON")

