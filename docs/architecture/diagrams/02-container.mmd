%% PromptGuard — C4 Level 2: Container
%% Quelle: docs/requirements/PRD.md §7, §12 (CON-001..CON-010); ADRs 001-009

C4Container
  title "PromptGuard — Container (C4 Level 2)"

  Person(dev, "Entwickler:in", "Anlegende und lesende Rolle.")
  Person(secadmin, "Security-Admin", "Prüfende und freigebende Rolle.")
  Person(orgadmin, "Org-Admin", "Verwaltende Rolle.")

  System_Boundary(pg, "PromptGuard") {
    Container(web, "Web-Frontend", "React 19, Next.js 15 (App Router), TypeScript strict", "Prompt-Register, Detailansicht, Editor, Versionshistorie, Fundstellen, Audit, Adminbereich. Liest den Live-Status über SSE, Fallback Polling.")
    Container(api, "API-Service", "Spring Boot 3, Java 21, Spring Web, Spring Security", "REST-API gemäß docs/api/openapi.yaml. Authentifizierung, Autorisierung, Mandantenfilter, Validierung, Fehlerabbildung (Problem Details).")
    Container(worker, "Scan-Worker", "Spring Boot 3, Java 21, Langchain4j", "Asynchroner Prüflauf: Warteschlange, Vorprüfung, Duplikatvergleich, LLM-Klassifikation, Aggregation, Statusübergänge, E-Mail-Auslösung.")
    Container(notify, "Notification-Worker", "Spring Boot 3, Java 21", "Zustellung der Warn-E-Mail mit Backoff, Totmannschaltung, manueller Wiederholung.")
    Container(retention, "Retention-Job", "Spring Boot 3, Java 21, Spring Scheduler", "Tägliche, idempotente Löschung von Telemetrie (> 90 Tage) und KI-Rohpayloads (> 24 h).")
    ContainerDb(db, "PostgreSQL 16", "PostgreSQL mit Row-Level-Security", "Fachdaten, Statusmodell, Audit, persistente Warteschlangen, Suchindex. Verschlüsselung ruhender Daten (SEC-012).")
    ContainerDb(outbox, "Status-Events (Tabelle)", "PostgreSQL", "Outbox für Statuswechsel: Quelle des SSE-Streams (Snapshot + Sequenz).")
  }

  System_Ext(llm, "KI-Dienst (EU)", "Gemini 2.0 Flash / OpenAI, europe-west3, kein Training, keine dauerhafte Speicherung, AVV (FR-065).")
  System_Ext(smtp, "SMTP-Server", "Zustellung der Warn-E-Mail.")

  Rel(dev, web, "Nutzt", "HTTPS")
  Rel(secadmin, web, "Nutzt", "HTTPS")
  Rel(orgadmin, web, "Nutzt", "HTTPS")
  Rel(web, api, "Ruft auf", "HTTPS/JSON, Bearer-JWT, SSE")
  Rel(api, db, "Liest/schreibt, immer mit organisation_id-Filter und RLS", "SQL/TCP")
  Rel(api, outbox, "Schreibt Statuswechsel (Outbox)", "SQL/TCP")
  Rel(api, worker, "Legt Scan-Jobs in die persistente Warteschlange", "SQL/TCP")
  Rel(worker, db, "Liest/scannt, schreibt Status und Fundstellen", "SQL/TCP")
  Rel(worker, outbox, "Schreibt Statuswechsel (Outbox)", "SQL/TCP")
  Rel(worker, llm, "Übermittelt Originalinhalt zur Klassifikation (F1, unredigiert)", "HTTPS, Langchain4j")
  Rel(worker, notify, "Legt Zustelljobs an", "SQL/TCP")
  Rel(notify, db, "Liest und aktualisiert Zustellversuche", "SQL/TCP")
  Rel(notify, smtp, "Sendet Warn-E-Mail (nur Metadaten)", "SMTP")
  Rel(retention, db, "Löscht Telemetrie und Rohpayloads", "SQL/TCP")
  Rel(api, web, "liefert Status-Events (SSE)", "text/event-stream")

  UpdateRelStyle(worker, llm, $lineColor="#b3261e", $textColor="#b3261e")
