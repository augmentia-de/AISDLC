%% PromptGuard — Sequenzdiagramm des asynchronen Prüfprozesses
%% Ablauf: Anlegen -> Warteschlange -> Vorprüfung -> Duplikatvergleich -> LLM-Klassifikation
%%         -> Aggregation -> Live-Status -> Alarm-Mail
%% Quelle: FR-030..FR-038, FR-040..FR-042, FR-050..FR-053 / ADR-005 (Live-Status), ADR-006 (Provider)

sequenceDiagram
    autonumber
    actor Dev as Entwickler:in
    participant UI as Web-Frontend
    participant API as API-Service
    participant DB as PostgreSQL 16
    participant W as Scan-Worker
    participant Pre as Lokale Vorprüfung
    participant Dup as Duplikatvergleich
    participant LLM as KI-Dienst (EU)
    participant SSE as SSE-Kanal
    participant NW as Notification-Worker
    participant SMTP as SMTP-Server

    %% ---------------------------------------------------------------- Anlegen
    Dev->>UI: Prompt anlegen (Titel, Inhalt, Kategorie, Tags)
    UI->>API: POST /api/v1/prompts + Bearer-JWT
    API->>API: Authentifizieren, Rolle prüfen, organisation_id aus dem Token
    API->>API: Validieren (Titel 1-200, Inhalt 1-50000, max. 10 Tags)
    API->>DB: INSERT prompt, prompt_version v1 (status PENDING, content_hash)
    API->>DB: INSERT scan_job (tenant context = organisation_id)
    API-->>UI: 201 Created (prompt, currentVersion mit status PENDING)
    Note over API,UI: Antwort kommt sofort — p95 < 500 ms (NFR-001).<br/>Die Prüfung blockiert die Oberfläche nicht (P3).

    %% ---------------------------------------------------------------- Warteschlange
    W->>DB: SELECT ... FROM scan_job WHERE status='QUEUED' ORDER BY created_at FOR UPDATE SKIP LOCKED
    DB-->>W: Job (mit organisation_id)
    W->>DB: status=SCANNING, attempt_count+1, locked_by
    W->>DB: Statusübergang PENDING -> SCANNING (Historie + Outbox)
    DB-->>SSE: Outbox-Ereignis (sequence)
    SSE-->>UI: SSE status event (status SCANNING, sequence)
    UI-->>Dev: Anzeige "wird geprüft" ohne Neuladen

    %% ---------------------------------------------------------------- Stufe (a) Vorprüfung
    W->>Pre: Stufe (a) — lokale deterministische Vorprüfung
    Pre-->>W: Fundstellen SECRET / PII (maskierte Ausschnitte, Position, Begründung)
    Note over Pre: Pflicht und zwingend VOR dem externen Aufruf (FR-031).<br/>Ergebnis fließt in das Gesamturteil ein.

    %% ---------------------------------------------------------------- Stufe (b) Duplikatvergleich
    W->>Dup: Stufe (b) — Duplikatvergleich
    Dup->>DB: Kandidaten aus der EIGENEN Organisation (organisation_id-Filter)
    DB-->>Dup: Kandidaten
    Dup-->>W: bis zu 5 ähnliche Prompts (Score, Titel, Verweis)
    Note over Dup: Schwellwert >= 0,90, organisationsweit konfigurierbar (F8).<br/>Nur beratend, blockiert nie (FR-032).

    %% ------------------------------------------------- Provider-Verifikation (Gate)
    W->>W: Provider-Verifikation: AVV, EU-Region, Trainingsverbot, Löschgarantie
    alt Verifikation nicht bestanden
        W->>DB: Version auf FAILED, Scan-Fehlercode PROVIDER_POLICY_VIOLATION
        W->>DB: Statusübergang SCANNING -> FAILED
        DB-->>SSE: Outbox-Ereignis
        SSE-->>UI: SSE status event (status FAILED, retryable true)
        Note over W,LLM: Kein Inhalt verlässt das System (FR-038, AC-022-2).
    else Verifikation bestanden
        %% ------------------------------------------------------- Stufe (c) LLM-Klassifikation
        W->>LLM: Stufe (c) — Originalinhalt unverändert zur Klassifikation
        Note over W,LLM: [SECURITY] F1 — unredigierte Übermittlung.<br/>Prüfling wird als Datenblock übergeben,<br/>Systemanweisung des Prüfers dominiert (SEC-007).
        LLM-->>W: Urteil + Begründung (Injection / Jailbreak)
        W->>DB: INSERT transfer_audit (Metadaten ohne Inhalt)
        Note over W,DB: Zeitpunkt, Provider, Modell, Zeichenlänge,<br/>Ergebnis-ID, Korrelation-ID (FR-074, Art. 30 DSGVO).

        %% ------------------------------------------------------- Stufe (d) Aggregation
        W->>W: Stufe (d) — Aggregation zum Gesamturteil
        alt Mindestens ein Fund >= Schwelle
            W->>DB: Version auf FLAGGED, Fundstellen speichern
            W->>DB: Statusübergang SCANNING -> FLAGGED
            DB-->>SSE: Outbox-Ereignis
            SSE-->>UI: SSE status event (status FLAGGED, sequence)
            UI-->>Dev: "Geflaggt" + Fundstellen (maskierte Ausschnitte)

            %% ------------------------------------------------------- Alarm-Mail
            W->>DB: INSERT notification_delivery je Empfänger
            Note over W,DB: Empfänger = Security-Admins, ist keiner hinterlegt,<br/>die ORG_ADMINs (FR-053).
            NW->>DB: Zustelljob übernehmen
            NW->>SMTP: Warn-E-Mail (Organisation, Prompt-ID/Titel, Version,<br/>Kategorien, Schweregrade, Zeitpunkt, Deep-Link)
            Note over NW,SMTP: KEIN Prompt-Inhalt, KEIN Secret, KEINE Fundstellen-Ausschnitte (FR-051).
            alt SMTP nicht erreichbar
                NW->>DB: attempts+1, next_retry_at = jetzt + Backoff
                Note over NW,DB: Nach Erschöpfung: DEAD_LETTER, in der Oberfläche sichtbar,<br/>manuelle Wiederholung möglich (FR-052).
            else Zustellung erfolgreich
                NW->>DB: status=SENT, sent_at=jetzt
            end
            Note over W,SMTP: Der Prüfstatus bleibt unabhängig vom Zustellerfolg (AC-027-3).
        else Kein Fund >= Schwelle
            W->>DB: Version auf APPROVED, leere Fundstellen
            W->>DB: Statusübergang SCANNING -> APPROVED
            DB-->>SSE: Outbox-Ereignis
            SSE-->>UI: SSE status event (status APPROVED, sequence)
            UI-->>Dev: "Freigegeben" — erst jetzt ist der Prompt nutzbar (I-3)
        end
    end

    %% ---------------------------------------------------------------- Wiederherstellung
    UI->>API: GET /api/v1/prompts/<promptId>/status (Fallback / Wiederherstellung)
    API-->>UI: (status, sequence) — aktueller Stand, keine veralteten Zwischenstände
    Note over UI,API: Snapshot bei Verbindungsabbruch, der Client verwirft<br/>Ereignisse mit sequence <= zuletzt gesehen (AC-024-3).
