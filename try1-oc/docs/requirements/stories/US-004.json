{
  "id": "US-004",
  "epic": "E1",
  "title": "Status aendern",
  "description": "As a support agent, I want to change a ticket's status, so that progress is reflected.",
  "requirement_ids": ["FR-007", "FR-018", "FR-019", "FR-020"],
  "acceptance_criteria": [
    { "id": "AC-004-1", "given": "a ticket with status open", "when": "PATCH /api/v1/tickets/{id} with status in_progress", "then": "200 OK with status=in_progress" },
    { "id": "AC-004-2", "given": "a ticket exists", "when": "PATCH /api/v1/tickets/{id} with status 'done'", "then": "400 Bad Request with structured error" },
    { "id": "AC-004-3", "given": "no ticket with id X", "when": "PATCH /api/v1/tickets/{X} with status closed", "then": "404 Not Found with structured error" }
  ],
  "priority": "must-have",
  "status": "todo"
}