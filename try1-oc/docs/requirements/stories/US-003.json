{
  "id": "US-003",
  "epic": "E1",
  "title": "Ticket aktualisieren",
  "description": "As a support agent, I want to update title, description and priority of a ticket, so that information stays correct.",
  "requirement_ids": ["FR-006", "FR-019", "FR-020"],
  "acceptance_criteria": [
    { "id": "AC-003-1", "given": "a ticket exists", "when": "PATCH /api/v1/tickets/{id} with new title", "then": "200 OK with updated ticket and updated_at changed" },
    { "id": "AC-003-2", "given": "a ticket exists", "when": "PATCH /api/v1/tickets/{id} with empty title", "then": "400 Bad Request with structured error" },
    { "id": "AC-003-3", "given": "no ticket with id X", "when": "PATCH /api/v1/tickets/{X}", "then": "404 Not Found with structured error" }
  ],
  "priority": "must-have",
  "status": "todo"
}