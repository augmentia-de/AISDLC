{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile"],
  "properties": {
    "$schema": { "type": "string" },
    "profile": {
      "type": "string",
      "enum": ["mvp", "enterprise"],
      "default": "enterprise"
    },
    "mode": {
      "type": "string",
      "enum": ["greenfield", "migration", "brownfield"],
      "default": "greenfield"
    },
    "allow_fast_track": { "type": "boolean", "default": false },
    "traceability": {
      "type": "string",
      "enum": ["off", "light", "full"],
      "default": "full"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforce_gate1": { "type": "boolean", "default": true },
        "enforce_gate2": { "type": "boolean", "default": true },
        "traceability_hard_fail": { "type": "boolean", "default": true },
        "enforce_cutover_gate": { "type": "boolean", "default": true }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["strangler-fig", "big-bang", "module-migration", "parallel-run"],
          "default": "strangler-fig"
        },
        "cutover_approval_required": { "type": "boolean", "default": true },
        "dual_write": { "type": "boolean", "default": false },
        "parallel_run_required": { "type": "boolean", "default": true }
      }
    },
    "change_flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforce_classification": { "type": "boolean", "default": true },
        "allow_delta_for_hotfix_patch": {
          "type": "boolean",
          "default": true,
          "description": "Enables the delta flow (1a -> 5a -> 6a -> 8a) for hotfix, patch, feature and refactor."
        },
        "require_change_brief": { "type": "boolean", "default": true }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforce_minimal_scan": { "type": "boolean", "default": true },
        "block_on_critical_secrets": { "type": "boolean", "default": true }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "briefing_first": { "type": "boolean", "default": true },
        "strict_three_line_reply": { "type": "boolean", "default": false }
      }
    }
  }
}