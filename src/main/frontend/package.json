{
  "name": "echobox-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "EchoBox-Oberflaeche — Next.js 15 (App Router), React 19, TypeScript strict.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run ../../../tests/unit/frontend/a11y.test.tsx",
    "test:e2e:a11y": "playwright test a11y.spec.ts",
    "contract:check": "node scripts/check-contract-types.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run contract:check && npm run test"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
