<?xml version="1.0" encoding="UTF-8"?>
<!--
  EchoBox — Ereignis-Briefkasten mit Zustellgarantie
  Maven-Build (Java 21, Spring Boot 3).

  Besonderheit: die Tests liegen NICHT unter src/test/java, sondern unter tests/
  (unit, integration, contract, performance). Die Verzeichnisse werden als
  zusaetzliche Test-Quellverzeichnisse eingebunden (build-helper-maven-plugin).
  Surefire fuehrt *Test aus, Failsafe *IT. Vertrags- und Lasttests liegen in
  einem eigenen Profil, damit sie nicht in der normalen Suite laufen.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot 3.5.16 — S-19 (High).
    Die Version bringt tomcat-embed-core 10.1.55 mit. Damit sind die drei
    erreichbaren Advisories des HTTP/1.1-Pfades behoben:
      * CVE-2026-24880 (Request/Response-Smuggling) — behoben in 10.1.52,
      * CVE-2025-48988 (Multipart-DoS)             — behoben in 10.1.42,
      * CVE-2025-48989 („made you reset")           — behoben in 10.1.44.
    Die Mindestversion des eingebetteten Containers ist 10.1.55; die Regression
    prueft das (S-19) im Abhaengigkeitsbaum.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.echobox</groupId>
  <artifactId>echobox</artifactId>
  <version>1.0.0</version>
  <name>echobox</name>
  <description>Ereignis-Briefkasten mit Zustellgarantie</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <testcontainers.version>1.20.4</testcontainers.version>
    <wiremock.version>3.9.2</wiremock.version>
    <build-helper-plugin.version>3.6.0</build-helper-plugin.version>
    <!--
      Die Version des eingebetteten Containers ist eine **untere** Grenze:
      tomcat-embed-core < 10.1.55 traegt die drei erreichbaren Advisories
      S-19 (CVE-2026-24880, CVE-2025-48988, CVE-2025-48989).
    -->
    <tomcat.version>10.1.55</tomcat.version>
    <jacoco.version>0.8.13</jacoco.version>
  </properties>

  <dependencies>
    <!-- Laufzeit: Web, Security (JWT), Validierung, JdbcTemplate, Actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Persistenz: PostgreSQL 16 + Flyway -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Test-Stack: JUnit 5, AssertJ, Spring Security Test, Testcontainers -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WireMock: der simulierte Empfaenger der Zustell- und Signaturtests -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>echobox</finalName>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Die Testquellen liegen unter tests/, nicht unter src/test/java.
        Nur die Unit- und Integrationstests gehoeren in die normale Suite.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${build-helper-plugin.version}</version>
        <executions>
          <execution>
            <id>add-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/tests/unit</source>
                <source>${project.basedir}/tests/integration</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Die Coverage-Messung beginnt bei **null**: die alte Datei
        `target/jacoco.exec` wird vor dem Build geloescht. Ohne diesen Schritt
        wuerde das Gate die Daten *aller* frueheren Laeufe mitzaehlen und
        koennte eine Regression verdecken.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-jacoco-exec</id>
            <phase>initialize</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco.exec</include>
                  </includes>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        JaCoCo — das Coverage-Gate des Builds (A-1).

        Die Zusage „min. 80 % Testabdeckung" ist nur eine Zusage, wenn der
        Build sie **erzwingt**. `check` bricht den Build ab, sobald die
        Zeilenabdeckung des Bundles unter 80 % faellt. Der Bericht liegt in
        `target/site/jacoco` (HTML, XML, CSV).

        `prepare-agent` laeuft vor den Tests, `report` und `check` in der
        Phase `verify` — also nach Surefire **und** Failsafe: das Gate misst
        die Unit- **und** die Integrationstests.

        `append` ist **wahr**: jeder Testlauf startet eine eigene JVM, und
        jede JVM schreibt ihr Ergebnis in dieselbe Datei. Ohne `append` wuerde
        die letzte JVM die Daten der uebrigen ueberschreiben.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <formats>
                <format>HTML</format>
                <format>XML</format>
                <format>CSV</format>
              </formats>
            </configuration>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Surefire: *Test (Unit- und Integrationstests der normalen Suite) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>

      <!-- Failsafe: *IT (Integrationstests, brauchen PostgreSQL aus Testcontainers) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <excludes>
            <exclude>**/*Test.java</exclude>
          </excludes>
          <!--
            Jede Testklasse laeuft in einem **eigenen** JVM — damit bekommt sie
            auch einen **eigenen** PostgreSQL-Container (Teststrategie §2: "Die
            Daten sind getrennt, die Datenbank nicht"). Ohne diese Trennung
            waeren die Testdaten der Klassen ueber den gemeinsamen Container
            voneinander abhaengig (Reihenfolgeabhaengigkeit).
          -->
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Vertrags- und Lasttests: eigenes Profil, damit der Lasttest (NFR-002)
      nicht in der normalen Suite laeuft (Teststrategie §1, §6.3).
        mvn -Pcontract-performance verify
    -->
    <profile>
      <id>contract-performance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>${build-helper-plugin.version}</version>
            <executions>
              <execution>
                <id>add-contract-performance-test-sources</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${project.basedir}/tests/contract</source>
                    <source>${project.basedir}/tests/performance</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
