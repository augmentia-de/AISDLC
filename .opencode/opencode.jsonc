{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "aisdlc-requirements",

  // Stack-Wissen kommt direkt aus den Bibliotheken - keine Kopien, keine Drift.
  // Pfade sind maschinenabhaengig; bei Umzug anpassen oder die Skills vendoren.
  "skills": {
    "paths": [
      "/home/torsten/dev/my-projects/agents/ECC/skills",
      "/home/torsten/dev/my-projects/agents/wshobson-agents/plugins/backend-development/skills",
      "/home/torsten/dev/my-projects/agents/wshobson-agents/plugins/frontend-mobile-development/skills",
      "/home/torsten/dev/my-projects/agents/wshobson-agents/plugins/javascript-typescript/skills"
    ]
  },

  "permissions": [
    // Subagents: nur die projektspezifischen duerfen gestartet werden
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "aisdlc-*", "effect": "allow" },
    { "action": "subagent", "resource": "stack/*", "effect": "allow" },
    { "action": "subagent", "resource": "general", "effect": "allow" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },

    // Skills: nur projektrelevante laden (ECC hat 311, wshobson 185)
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "aisdlc-*", "effect": "allow" },
    { "action": "skill", "resource": "strangler-fig", "effect": "allow" },
    { "action": "skill", "resource": "module-migration", "effect": "allow" },
    { "action": "skill", "resource": "test-self-correction", "effect": "allow" },
    { "action": "skill", "resource": "springboot-*", "effect": "allow" },
    { "action": "skill", "resource": "java-*", "effect": "allow" },
    { "action": "skill", "resource": "react-*", "effect": "allow" },
    { "action": "skill", "resource": "typescript-*", "effect": "allow" },
    { "action": "skill", "resource": "modern-javascript-*", "effect": "allow" },
    { "action": "skill", "resource": "nodejs-*", "effect": "allow" },
    { "action": "skill", "resource": "nextjs-*", "effect": "allow" },
    { "action": "skill", "resource": "tailwind-*", "effect": "allow" },
    { "action": "skill", "resource": "microservices-*", "effect": "allow" },
    { "action": "skill", "resource": "api-design-*", "effect": "allow" },
    { "action": "skill", "resource": "python-*", "effect": "allow" },
    { "action": "skill", "resource": "golang-*", "effect": "allow" },
    { "action": "skill", "resource": "rust-*", "effect": "allow" },
    { "action": "skill", "resource": "fastapi-*", "effect": "allow" },
    { "action": "skill", "resource": "quarkus-*", "effect": "allow" },
    { "action": "skill", "resource": "dotnet-*", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" }
  ]
}
